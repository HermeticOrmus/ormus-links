# Required: Anthropic API key for AI-powered link analysis
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Server port (default: 3000)
PORT=3000

# Optional: AI model to use (default: claude-haiku-4-5-20251001)
AI_MODEL=claude-haiku-4-5-20251001

# Optional: Describe what kind of content you save, used in the AI analysis prompt
# Default: "general web content, articles, tools, and references"
AI_CONTEXT=dev workflows, AI tooling, software engineering

# Optional: Map Cloudflare Access emails to display names
# Format: email1:name1,email2:name2
AUTH_MAP=user@example.com:alice,other@example.com:bob
